{
  "name": "@forensix/core",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts/*": "./dist/contracts/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-contracts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
