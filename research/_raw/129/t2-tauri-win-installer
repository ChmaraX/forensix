pan class="indent"><span style="--0:#D6DEEB;--1:#403F53">  </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div></code></pre><div class="copy"><div aria-live="polite"></div><button title="Copy to clipboard" data-copied="Copied!" data-code="{  &quot;bundle&quot;: {    &quot;windows&quot;: {      &quot;webviewInstallMode&quot;: {        &quot;type&quot;: &quot;fixedRuntime&quot;,        &quot;path&quot;: &quot;./Microsoft.WebView2.FixedVersionRuntime.98.0.1108.50.x64/&quot;      }    }  }}"><div></div></button></div></figure></div>
