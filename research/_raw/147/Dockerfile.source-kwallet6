# 147 Source image — KWallet6 (Debian trixie, arm64), branded Google Chrome
FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      wget curl gnupg ca-certificates \
      xvfb fluxbox dbus-x11 x11-utils \
      kwallet6 kwalletcli qdbus-qt6 \
      fonts-liberation libnss3 libxss1 libasound2 \
      procps xxd file jq python3 python3-cryptography sqlite3 \
      libxcb-cursor0 locales-all socat \
      gpg gpg-agent \
    && rm -rf /var/lib/apt/lists/*
RUN wget -q -O /tmp/gk.pub https://dl.google.com/linux/linux_signing_key.pub \
    && install -d -m 0755 /etc/apt/keyrings \
    && gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg /tmp/gk.pub \
    && echo "deb [arch=arm64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update && apt-get install -y --no-install-recommends google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
CMD ["sleep","infinity"]
